{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recall",
  "version": "0.1.0",
  "identifier": "com.grandballoon.recall",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Recall",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/Recall.icon",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
